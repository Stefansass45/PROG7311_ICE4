@model WarDogsShop.Models.Product

@{
    ViewData["Title"] = "Edit";
}

<head>
    <link rel="stylesheet" href="StorePage/Edit.cshtml.css">

    <style>
        body {
            background-color: black;
        }

        .img-icon {
            height: auto;
            width: 75%;
            transition: filter 0.15s ease;
        }

    </style>
</head>

<h1 class="title">Edit</h1>

<h4 class ="subtitle">Product</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="id" />
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Category" class="control-label"></label>
                <input asp-for="Category" class="form-control" />
                <span asp-validation-for="Category" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Price" class="control-label"></label>
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>

    <div class="col-4">
        <div class="p-3">
            <div class="cat-div div-product">

                @if (Model.Category == "Narcotics")
                {
                    <img class="img-icon" src="~/Images/Image1.png" alt="Product Image" />
                }
                else if (Model.Category == "Hallucinogens")
                {
                    <img class="img-icon" src="~/Images/Image2.png" alt="Product Image" />
                }
                else
                {
                    <img class="img-icon" src="~/Images/Image3.png" alt="Product Image" />
                }

                <p class="p-product">@Model.Name</p>
                <p class="p-product-price">$@Model.Price</p>

            </div>
        </div>
    </div>


</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}