@model WarDogsShop.Models.Product

@{
    ViewData["Title"] = "Details";
}

<head>

    <link rel="stylesheet" href="StorePage/Details.cshtml.css">

    <style>
        body {
            background-color: black;
            padding-top: 60px;
        }

        .img-icon {
            height: auto;
            width: 75%;
            transition: filter 0.15s ease;
        }

    </style>
</head>

<h1 class="title">Details: @Model.Name</h1>

<div>
    <div class="row">
        <div class="col-6">
            <div class="p-3">
                <div class="cat-div div-product">

                    @if (Model.Category == "Narcotics")
                    {
                        <img class="img-icon" src="~/Images/Image1.png" alt="Product Image" />
                    }
                    else if (Model.Category == "Hallucinogens")
                    {
                        <img class="img-icon" src="~/Images/Image2.png" alt="Product Image" />
                    }
                    else
                    {
                        <img class="img-icon" src="~/Images/Image3.png" alt="Product Image" />
                    }

                    <p class="p-product">@Model.Name</p>
                    <p class="p-product-price">$@Model.Price</p>

                </div>
            </div>
        </div>

        <div class="col-6">
            <div class="p-3">

                <div class="mt-3">
                    <a asp-action="Edit" asp-route-id="@Model?.id" class="btn btn-primary me-2">Edit</a>
                    <a asp-action="Delete" asp-route-id="@Model?.id" class="btn btn-danger me-2">Delete</a>
                    <a href='@Url.Action("Index", "Store", new { title = Model?.Category })' class="btn btn-secondary">
                        Back to Category
                    </a>

                </div>

            </div>
        </div>


    </div>
</div>

