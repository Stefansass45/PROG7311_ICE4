@model WarDogsShop.Models.StoreModel;

@{
    ViewData["Title"] = "Store Page";
}

<head>
    <link rel="stylesheet" href="StorePage/Index.cshtml.css">

    <style>
        body {
        background-color: black;
        padding-top: 60px;
        }

        .a-product {
            font-size: 30px;
            color: white;
            font-family: Consolas;
            text-decoration: none
        }


    </style>
</head>

<body>
    <div class="text-center">
        <h1 class="title">@Model.Category</h1>
    </div>

    <div class="sidebar left-sidebar">

        <div class="ad-card add-4">
            <p>Download Bitcon For Free!!!</p>
            <button class="add-4-btn">
                Click Here!
            </button>
        </div>

        <div class="ad-card add-2">
            <img src="Images/ad1.png" alt="Ad 1" />
            <p>Click Here To Play Super Mario</p>

        </div>

        <div class="ad-card add-6">
            <img src="Images/Ad6.jpg" alt="Ad 1" />
            <p>Click Here To Play</p>

        </div>


    </div>

    <div class="container overflow-hidden">
        <div class="row gy-5">




            @foreach (var item in Model.Products)
            {
                @if (Model.Category != "All")
                {
                    @if (item.Category == Model.Category)
                    {

                        
                            <div class="col-3">
                                <div class="p-3">
                                    <div class="cat-div div-product">
                                        <a asp-action="Details" asp-route-id="@item.id" class="a-product">
                                        @if (item.Category == "Narcotics")
                                        {
                                            <img class="img-icon" src="Images/Image1.png" alt="Product Image" />
                                        }
                                        else if (item.Category == "Hallucinogens")
                                        {
                                            <img class="img-icon" src="Images/Image2.png" alt="Product Image" />
                                        }
                                        else
                                        {
                                            <img class="img-icon" src="Images/Image3.png" alt="Product Image" />
                                        }
                                        <p class="p-product">@item.Name</p>
                                        <p class="p-product-price">$@item.Price</p>
                                    </a>
                                    </div>
                                </div>
                            </div>
                       
                      
                    }
                }
                else
                {
                  


                        <div class="col-3">
                            <div class="p-3">
                                <div class="cat-div div-product">
                                      <a asp-action="Details" asp-route-id="@item.id">
                                    @if (item.Category == "Narcotics")
                                    {
                                        <img class="img-icon" src="Images/Image1.png" alt="Product Image" />
                                    }
                                    else if (item.Category == "Hallucinogens")
                                    {
                                        <img class="img-icon" src="Images/Image2.png" alt="Product Image" />
                                    }
                                    else
                                    {
                                        <img class="img-icon" src="Images/Image3.png" alt="Product Image" />
                                    }
                                    <p class="p-product">@item.Name</p>
                                    <p class="p-product-price">$@item.Price</p>
                                </a>
                                </div>
                            </div>
                        </div>

                   

                }

               
               
            }
        </div>
    </div>

    <div class="sidebar right-sidebar">
        <div class="ad-card add-3">
            <img src="Images/Ad3.jpg" alt="Ad 3" />
        </div>
        <div class="ad-card add-4">
            <p>Download Bitcon For Free!!!</p>
            <button class="add-4-btn">
                Click Here!
            </button>
        </div>

        <div class="ad-card add-5">

            <img class="img-add5" src="Images/Ad5.jpg" alt="Ad 1" />
            <p class="overlay-text">You'll Never Believe This One Simple Trick To Get Rid Of Back Pain</p>

        </div>
    </div>
</body>


