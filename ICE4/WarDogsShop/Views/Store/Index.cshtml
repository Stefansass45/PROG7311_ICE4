@model WarDogsShop.Models.StoreModel;

@{
    ViewData["Title"] = "Store Page";
}

<head>
    <link rel="stylesheet" href="StorePage/Index.cshtml.css">

    <style>
        body {
        background-color: black;
        }


    </style>
</head>

<body>
    <div class="text-center">
        <h1 class="title">@Model.Category</h1>
    </div>

    <div class="container overflow-hidden">
        <div class="row gy-5">




            @foreach (var item in Model.Products)
            {
                @if (Model.Category != "All")
                {
                    @if (item.Category == Model.Category)
                    {
                        <div class="col-3">
                            <div class="p-3">
                                <div class="cat-div div-product">
                                    @if (item.Category == "Narcotics")
                                    {
                                        <img class="img-icon" src="Images/Image1.png" alt="Product Image" />
                                    }
                                    else if (item.Category == "Hallucinogens")
                                    {
                                        <img class="img-icon" src="Images/Image2.png" alt="Product Image" />
                                    }
                                    else
                                    {
                                        <img class="img-icon" src="Images/Image3.png" alt="Product Image" />
                                    }
                                    <p class="p-product">@item.Name</p>
                                    <p class="p-product-price">$@item.Price</p>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-3">
                        <div class="p-3">
                            <div class="cat-div div-product">
                                @if (item.Category == "Narcotics")
                                {
                                    <img class="img-icon" src="Images/Image1.png" alt="Product Image" />
                                }
                                else if (item.Category == "Hallucinogens")
                                {
                                    <img class="img-icon" src="Images/Image2.png" alt="Product Image" />
                                }
                                else
                                {
                                    <img class="img-icon" src="Images/Image3.png" alt="Product Image" />
                                }
                                <p class="p-product">@item.Name</p>
                                <p class="p-product-price">$@item.Price</p>
                            </div>
                        </div>
                    </div>
                }

               
               
            }
        </div>
    </div>
</body>
