


@{
    ViewData["Title"] = "Home Page";
}





<head>
    <link rel="stylesheet" href="Home/Index.cshtml.css">

    <style>
        
        body{
            background-color:black;
        }
    </style>
</head>

<body>
    <div class="text-center">

        <h1 class="title">Welcome To War Dogs</h1>

        <h3 class="subtitle">How Would You Like To Continue...</h3>

    </div>



    <div class="container overflow-hidden">
        <div class="row gy-5">
            <div class="col-4">
                <div class="p-3">
                    <a class="card-a-tag" href='@Url.Action("Index", "Store", new { title = "Narcotics" })'>
                        <div class="cat-div div-narc">
                            <img class="img-icon" src="Images/Image1.png" alt="My Image" />
                            <p class="p-narc">/Narcotics</p>
                        </div>
                    </a>
                    
                    
                </div>
            </div>
            <div class="col-4">
                <div class="p-3">
                    <a class="card-a-tag" href='@Url.Action("Index", "Store", new { title = "Hallucinates" })'>
                    <div class="cat-div div-hallu">
                        <img class="img-icon" src="Images/Image2.png" alt="My Image" />
                        <p class="p-hallu">/Hallucinates</p>
                    </div>
                    </a>
                    
                </div>
            </div>
            <div class="col-4">
                <div class="p-3">
                    <a class="card-a-tag" href='@Url.Action("Index", "Store", new { title = "Prescriptions" })'>
           
                    <div class="cat-div div-perscript">
                        <img class="img-icon" src="Images/Image3.png" alt="My Image" />
                        <p class="p-perscript">/Prescriptions</p>
                    </div>
                    </a>
                    
                </div>
            </div>
        </div>
    </div>
</body>


